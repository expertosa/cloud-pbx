# ---- Domain & public address --------------------------------------------
DOMAIN=pbx.example.com
PUBLIC_URL=https://pbx.example.com
SIP_WS_URL=wss://pbx.example.com/ws
SIP_DOMAIN=pbx.example.com
# Public IP of this server (needed for SIP/RTP behind NAT)
EXTERNAL_IP=203.0.113.10

# ---- Secrets (generate with: openssl rand -hex 24) ----------------------
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
ARI_PASSWORD=change-me

# ---- Platform admin (created on first start) ----------------------------
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=change-me-too
# Let companies sign up on their own (false = you create them from the admin page)
ALLOW_SIGNUP=false

# ---- Telnyx trunk -------------------------------------------------------
# registration: Telnyx "Credentials" SIP connection (username/password)
# ip:           Telnyx "IP address" SIP connection (set TELNYX_SIGNALING_IPS)
TRUNK_MODE=registration
TELNYX_SIP_USER=
TELNYX_SIP_PASSWORD=
TELNYX_SIP_HOST=sip.telnyx.com
# TELNYX_SIGNALING_IPS=192.76.120.10,64.16.250.10
TRUNK_ENDPOINT=telnyx
# +e164 sends "+9665..." to Telnyx; e164 sends "9665..."
TRUNK_NUMBER_FORMAT=+e164

# ---- Media --------------------------------------------------------------
RTP_START=10000
RTP_END=20000
STUN_ADDR=stun.l.google.com:19302
VOICEMAIL_MAX_SECONDS=120
